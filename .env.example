# ==========================================
# NK Associates - Cashfree Payments Environment Variables
# ==========================================

# Cashfree API Credentials (from Cashfree Merchant Dashboard -> Developers -> API Keys)
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here

# Cashfree Environment: 'sandbox' for testing, 'production' for live payments
CASHFREE_ENV=sandbox

# Cashfree PG API Version (default: 2023-08-01)
CASHFREE_API_VERSION=2023-08-01

# Frontend Cashfree SDK Mode: 'sandbox' or 'production' (Exposed to client bundle via Vite)
VITE_CASHFREE_MODE=sandbox

# Database / Lead Storage (Optional: defaults to memory/file if omitted)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_or_service_key

# Email Notifications (Optional: configure for live order alert emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=care@nkassociate.in
# SMTP_PASS=your_smtp_app_password
# NOTIFICATION_EMAIL=info@nkassociate.in
